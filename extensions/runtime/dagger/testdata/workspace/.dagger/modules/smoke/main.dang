"""
Portable runtime integration fixture.
"""
type Smoke {
  pub source: Directory!

  new(ws: Workspace!) {
    self.source = ws.directory("/")
    self
  }

  pub verify: String! {
    container
      .from("alpine:3.22.1")
      .withExec(["sh", "-c", "printf portable-invoke-ok"])
      .stdout
  }

  pub packageFile: File! {
    container
      .from("alpine:3.22.1")
      .withNewFile("/out/artifact.txt", "file-output-ok\n")
      .file("/out/artifact.txt")
  }

  pub packageDirectory: Directory! {
    container
      .from("alpine:3.22.1")
      .withNewFile("/out/artifact.txt", "directory-output-ok\n")
      .directory("/out")
  }
}
